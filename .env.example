# ── SafeWay Configuration ─────────────────────────────
# Copy to .env and edit.

# App
APP_NAME=SafeWay
DEBUG=true
API_V1_PREFIX=/api/v1

# Zone: "peenya" | "subramanyapura"
ZONE=peenya
TIMEZONE=Asia/Kolkata

# PostgreSQL + PostGIS
DATABASE_URL=postgresql+asyncpg://safeway:safeway@localhost:5432/safeway
DATABASE_URL_SYNC=postgresql+psycopg://safeway:safeway@localhost:5432/safeway

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth / JWT
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Safety-cost weights (all floats, 0-1)
ALPHA_CRIME=0.4
BETA_DARKNESS=0.3
GAMMA_ISOLATION=0.2
DELTA_ACTIVITY=0.1

# SOS
SOS_COUNTDOWN_SECONDS=5

# Volunteers
VOLUNTEER_RADIUS_M=1000

# Trip monitoring
TRIP_STALE_MINUTES=5
TRIP_DEVIATION_METERS=200.0
TRIP_UNUSUAL_STOP_MINUTES=3.0
TRIP_ARE_YOU_OKAY_SECONDS=20
TRIP_LOCATION_RETENTION_DAYS=7

# Notification / AI providers – mock implementations need NO keys
SMS_PROVIDER=mock
PUSH_PROVIDER=mock
LLM_PROVIDER=mock

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
